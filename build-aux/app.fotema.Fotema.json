{
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
        "build-args": [
            "--share=network"
        ],
        "env": {
            "AWS_LC_SYS_NO_JITTER_ENTROPY": "1",
            "CARGO_REGISTRIES_CRATES_IO_PROTOCOL": "sparse",
            "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER": "clang",
            "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS": "-C link-arg=-fuse-ld=/usr/lib/sdk/rust-stable/bin/mold",
            "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER": "clang",
            "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS": "-C link-arg=-fuse-ld=/usr/lib/sdk/rust-stable/bin/mold"
        },
        "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib",
        "test-args": [
            "--socket=x11",
            "--share=network"
        ]
    },
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/girepository-1.0",
        "/lib/pkgconfig",
        "/share/gir-1.0",
        "*.la",
        "*.a"
    ],
    "command": "fotema",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--env=RUSTICL_ENABLE=iris,radeonsi",
        "--env=OCL_ICD_VENDORS=/usr/lib/x86_64-linux-gnu/GL/default/lib/OpenCL/vendors"
    ],
    "id": "app.fotema.Fotema",
    "modules": [
        "modules/libshumate.json",
        "modules/opencv.json",
        "modules/libonnxruntime.json",
        {
            "build-options": {
                "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
                "env": {
                    "LIBCLANG_PATH": "/usr/lib/sdk/llvm22/lib",
                    "OPENCV_INCLUDE_PATHS": "/app/include/opencv5",
                    "ORT_STRATEGY": "system"
                },
                "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib"
            },
            "buildsystem": "meson",
            "config-opts": [
                "-Dprofile=default"
            ],
            "name": "fotema",
            "run-tests": true,
            "sources": [
                {
                    "path": "../",
                    "skip": [
                        "target",
                        ".flatpak",
                        ".flatpak-builder",
                        ".git",
                        "fotema.flatpak",
                        "Beispielfotos",
                        ".vscode",
                        "_build",
                        "builddir"
                    ],
                    "type": "dir"
                }
            ]
        }
    ],
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm22"
    ]
}
